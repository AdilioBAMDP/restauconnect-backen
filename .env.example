# ========================
# RESTAUCONNECT BACKEND
# Configuration Template
# ========================
# 📝 Copiez ce fichier vers .env et remplissez TOUTES les valeurs
# ⚠️  NE JAMAIS commiter le fichier .env (contient secrets production)

# ========================
# APPLICATION
# ========================
NODE_ENV=development
PORT=5000
APP_NAME=RestauConnect
APP_VERSION=1.0.0

# ========================
# BASE DE DONNÉES MONGODB
# ========================
# Développement local
MONGODB_URI=mongodb://localhost:27017/restauconnect
DB_NAME=restauconnect

# Production (avec authentification)
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/restauconnect?retryWrites=true&w=majority

# ========================
# JWT AUTHENTICATION (CRITICAL!)
# ========================
# ⚠️  GÉNÉRATION OBLIGATOIRE POUR PRODUCTION
# Générer avec: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=votre-jwt-secret-super-securise-64-caracteres-minimum
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=votre-refresh-secret-super-securise-64-caracteres-minimum
JWT_REFRESH_EXPIRE=30d

# ========================
# SÉCURITÉ
# ========================
BCRYPT_SALT_ROUNDS=12
SESSION_SECRET=votre-session-secret-super-securise-64-caracteres
COOKIE_SECRET=votre-cookie-secret-super-securise

# ========================
# URLS
# ========================
CLIENT_URL=http://localhost:3000
API_URL=http://localhost:5000
PWA_URL=http://localhost:8087
WEB_URL=http://localhost:5173

# ========================
# CORS
# ========================
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://localhost:8087

# ========================
# EMAIL SERVICE (Nodemailer)
# ========================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=votre-email@gmail.com
SMTP_PASS=votre-mot-de-passe-application
EMAIL_FROM=RestauConnect <noreply@restauconnect.com>
EMAIL_FROM_NAME=RestauConnect
EMAIL_FROM_ADDRESS=noreply@restauconnect.com

# ========================
# CLOUDINARY (Upload fichiers)
# ========================
CLOUDINARY_CLOUD_NAME=votre-cloud-name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=votre-cloudinary-api-secret

# ========================
# STRIPE PAYMENTS
# ========================
# ⚠️  Développement: Utiliser clés TEST (sk_test_...)
STRIPE_SECRET_KEY=sk_test_votre_cle_test_stripe
STRIPE_PUBLIC_KEY=pk_test_votre_cle_publique_test_stripe
STRIPE_WEBHOOK_SECRET=whsec_votre_webhook_secret

# ⚠️  Production: Utiliser clés LIVE (sk_live_...)
# STRIPE_SECRET_KEY=sk_live_votre_cle_live_stripe
# STRIPE_PUBLIC_KEY=pk_live_votre_cle_publique_live_stripe
# STRIPE_WEBHOOK_SECRET=whsec_votre_webhook_secret_live

# ========================
# GOOGLE MAPS
# ========================
GOOGLE_MAPS_API_KEY=votre-google-maps-api-key

# ========================
# FIREBASE (Push Notifications)
# ========================
FIREBASE_SERVER_KEY=votre-firebase-server-key
FIREBASE_PROJECT_ID=restauconnect-dev

# ========================
# REDIS (Optionnel - Cache/Sessions)
# ========================
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ========================
# RATE LIMITING
# ========================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ========================
# UPLOAD CONFIGURATION
# ========================
MAX_FILE_SIZE=10485760
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/gif,image/webp
ALLOWED_DOCUMENT_TYPES=application/pdf,application/msword

# ========================
# LOGGING
# ========================
LOG_LEVEL=debug
LOG_FILE=logs/app.log
DEBUG=restauconnect:*
VERBOSE=true
ENABLE_LOGGING=true
ENABLE_METRICS=false

# ========================
# SEARCH CONFIGURATION
# ========================
SEARCH_DEFAULT_LIMIT=20
SEARCH_MAX_LIMIT=100
SEARCH_DEFAULT_RADIUS=50000

# ========================
# NOTIFICATIONS
# ========================
PUSH_NOTIFICATIONS_ENABLED=false
EMAIL_NOTIFICATIONS_ENABLED=true
SMS_NOTIFICATIONS_ENABLED=false

# ========================
# MODE TEST (DEVELOPMENT ONLY!)
# ========================
# ⚠️  METTRE À false EN PRODUCTION
TEST_MODE=true
MONGODB_HOST=localhost:27017

# ========================
# CLOUDINARY WEBHOOK (Optionnel)
# ========================
CLOUDINARY_WEBHOOK_SECRET=votre-cloudinary-webhook-secret

# ========================
# SOCKET.IO
# ========================
SOCKET_CORS_ORIGIN=http://localhost:3000
