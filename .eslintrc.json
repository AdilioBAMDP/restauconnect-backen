{
  "extends": [
    "eslint:recommended",
    "plugin:@typescript-eslint/recommended"
  ],
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": 2021,
    "sourceType": "module",
    "project": "./tsconfig.json"
  },
  "plugins": [
    "@typescript-eslint"
  ],
  "rules": {
    "no-console": ["error", { "allow": [] }],
    "@typescript-eslint/no-explicit-any": "off",
    "@typescript-eslint/no-unused-vars": ["warn", { "argsIgnorePattern": "^_" }]
  },
  "env": {
    "node": true,
    "es2021": true
  },
  "ignorePatterns": [
    "dist/",
    "node_modules/",
    "*.js"
  ],
  "overrides": [
    {
      "files": [
        "src/utils/logger.ts",
        "src/__tests__/setup.ts",
        "src/**/*.test.ts",
        "src/**/*.spec.ts"
      ],
      "rules": {
        "no-console": "off"
      }
    }
  ]
}
